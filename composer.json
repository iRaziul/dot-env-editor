{
    "name": "larament/dot-env-editor",
    "description": "Super simple PHP package for updating .env files",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Raziul Islam",
            "email": "raziul.dev@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.1"
    },
    "replace": {
        "digimax/dot-env-editor": "self.version"
    },
    "autoload": {
        "psr-4": {
            "Larament\\DotEnvEditor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Larament\\DotEnvEditor\\Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.1"
    }
}
